# Deterministic stable-ID particles following an analytic flow field.
amr 1
evaluator 1
seed 7001
render 160 120 "reference"
node "particles" "core.motion.particles" 1
param "particles" "count" i64 112
param "particles" "lifetime" i64 4096
param "particles" "spawn" enum "seeded"
param "particles" "mode" enum "flow"
param "particles" "speed" f64 0.0055
param "particles" "turn_strength" f64 0.42
param "particles" "field_scale" f64 4.5
param "particles" "target_x" f64 0.5
param "particles" "target_y" f64 0.5
param "particles" "boundary" enum "repeat"
param "particles" "trail_length" i64 28
node "deposit" "core.particles.deposit.image" 1
param "deposit" "radius" f64 0.008
param "deposit" "intensity" f64 0.24
param "deposit" "trail_decay" f64 0.86
param "deposit" "palette" enum "heat"
edge "particles" "value" "deposit" "particles"
output "main" "deposit" "value"
meta "example.family" "motion-flow"
