# Image history is legal only because the loop crosses delay.previous/next.
amr 1
evaluator 1
seed 7003
render 128 128 "reference"
node "particles" "core.motion.particles" 1
param "particles" "count" i64 72
param "particles" "lifetime" i64 2048
param "particles" "spawn" enum "center"
param "particles" "mode" enum "walker"
param "particles" "speed" f64 0.009
param "particles" "turn_strength" f64 0.34
param "particles" "field_scale" f64 5.0
param "particles" "target_x" f64 0.5
param "particles" "target_y" f64 0.5
param "particles" "boundary" enum "repeat"
param "particles" "trail_length" i64 14
node "current" "core.particles.deposit.image" 1
param "current" "radius" f64 0.008
param "current" "intensity" f64 0.34
param "current" "trail_decay" f64 0.78
param "current" "palette" enum "heat"
node "history" "core.state.delay.image" 1
param "history" "initial" enum "black"
node "blend" "core.image.blend" 1
param "blend" "history_weight" f64 0.86
edge "particles" "value" "current" "particles"
edge "current" "value" "blend" "current"
edge "history" "previous" "blend" "history"
edge "blend" "value" "history" "next"
output "main" "blend" "value"
meta "example.family" "explicit-feedback-trails"
