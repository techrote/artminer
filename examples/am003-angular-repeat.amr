# Angular coordinate field, repeated structurally and mapped through a custom gradient.
amr 1
evaluator 1
seed 20260916
render 256 256 "reference"
node "angle" "core.scalar.angular" 1
param "angle" "center_x" f64 0.5
param "angle" "center_y" f64 0.5
param "angle" "turns" f64 9
param "angle" "phase" f64 0.125
node "repeat" "core.scalar.transform.repeat" 1
param "repeat" "x_count" i64 2
param "repeat" "y_count" i64 2
node "palette" "core.palette.gradient2" 1
param "palette" "r0" f64 0.02
param "palette" "g0" f64 0.08
param "palette" "b0" f64 0.18
param "palette" "a0" f64 1
param "palette" "r1" f64 0.92
param "palette" "g1" f64 0.93
param "palette" "b1" f64 0.42
param "palette" "a1" f64 1
node "colour" "core.colour.from_palette" 1
param "colour" "mode" enum "linear"
node "image" "core.image.from_colour" 1
edge "angle" "value" "repeat" "source"
edge "repeat" "value" "colour" "source"
edge "palette" "value" "colour" "palette"
edge "colour" "value" "image" "source"
output "main" "image" "value"
meta "example.family" "angular-repeat"
